# 本地配置：含真实会话 id 与本机路径，绝不入库
postgull.config.json
*.config.json
!postgull.config.example.json

# 注册表同样含真实会话 id
registry.json
!monitor/registry.example.json

# 信箱：含消息正文与凭证，绝不入库
queue/
**/queue/
*.jsonl
!skills/**/*.jsonl
# 归档里的凭证号与消息正文同样敏感，连归档一起挡
queue/archive.jsonl

# 构建产物与构建期依赖
dist/
build/node_modules/
build/bundle.cjs
build/sea-prep.blob
build/sea-config.json
build/package-lock.json

# Python 构建脚本的字节码缓存
__pycache__/
*.pyc

# 测试与临时
.test/
*.log
*.tmp
Thumbs.db
desktop.ini

# 内部审查草稿，不进发布包
docs/

# 编辑器
.vscode/
.idea/
